// Cloudflare Workers static-assets deploy. See DEPLOYMENT.md.
{
  "name": "tarot",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Serve index.html (200) for client-side routes like /deck and /tutorial.
    "not_found_handling": "single-page-application"
  },
  // Required by `wrangler preview`, which Workers Builds runs for non-production branches.
  "previews": {}
}
